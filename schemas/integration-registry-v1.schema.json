{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.org/schemas/pi/integration-registry-v1.schema.json",
  "title": "Kujo Pi integration registry v1",
  "type": "object",
  "required": ["schemaVersion", "registryVersion", "issuedAt", "ecosystemRootEnvironment", "integrations"],
  "properties": {
    "schemaVersion": { "const": "kujo.pi.integration-registry.v1" },
    "registryVersion": { "const": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "ecosystemRootEnvironment": { "const": "KUJO_ECOSYSTEM_ROOT" },
    "integrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "capabilities", "command", "binaryEnvironment", "entrypointEnvironment", "relativeEntrypoint", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "version": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
          "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "command": { "type": ["string", "null"] },
          "binaryEnvironment": { "type": ["string", "null"] },
          "entrypointEnvironment": { "type": "string", "pattern": "^KUJO_[A-Z0-9_]+$" },
          "relativeEntrypoint": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
