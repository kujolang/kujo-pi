{
  "name": "@kujolang/kujo-pi",
  "version": "0.3.0",
  "description": "Opt-in Pi package for Kujo skills, repository intelligence, and review artifacts.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "kujo",
    "agent-skills",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kujolang/kujo-pi.git"
  },
  "homepage": "https://github.com/kujolang/kujo-pi#readme",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10"
  },
  "files": [
    "extensions",
    "skills",
    "prompts",
    "src",
    "integrations",
    "schemas",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "bash tests/release-readiness.sh",
    "test:docs": "node tests/docs-contract.mjs",
    "test:extension": "tsx tests/extension-contract.ts",
    "test:live": "node tests/live-smoke.mjs",
    "test:host": "node tests/pi-host-contract.mjs",
    "test:performance": "node tests/performance-contract.mjs",
    "release:artifacts": "node scripts/build-release-artifacts.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "git diff --check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.3 <1",
    "@earendil-works/pi-tui": ">=0.84.3 <1",
    "typebox": ">=1.3.19 <2"
  },
  "pi": {
    "extensions": [
      "./extensions/kujo.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@types/node": "^26.4.0",
    "typebox": "^1.3.19",
    "typescript": "^7.0.2",
    "tsx": "^4.20.5"
  }
}
